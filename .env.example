# Login wall (required — without both, the site stays locked).
# Signs the session cookie; 32+ random characters. Changing it signs everyone out.
AUTH_SECRET=
# Comma-separated username:password pairs. Removing a user revokes their access at once.
DASHBOARD_USERS=dimas:change-me-long-password
# Live mode: Meta system-user token with ads_read on every client ad account.
META_ACCESS_TOKEN=
# Required for the daily cron route; Vercel sends it as a Bearer token.
CRON_SECRET=
# META_GRAPH_VERSION=v21.0
